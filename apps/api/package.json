{
  "name": "@aba/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express domain API for AI Business Assistant Kuwait",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "seed:dev": "tsx src/scripts/seed-dev.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aba/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aba/config": "*",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "firebase": "^12.18.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
