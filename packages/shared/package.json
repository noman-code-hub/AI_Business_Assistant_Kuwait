{
  "name": "@aba/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types, Zod schemas, constants, and error codes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aba/config": "*",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
